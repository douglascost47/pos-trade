# Copie para .env (o .env fica fora do git):  cp .env.example .env

# 'Y' aceita as licenças do SQL Server e do emulador do Service Bus:
# https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=Y

# Senha forte: 8+ caracteres com maiúscula, minúscula, número e símbolo.
# Evite $ e aspas para não brigar com o shell.
MSSQL_SA_PASSWORD=PosTrade#Lab2026

# Mude se a 1433 já estiver ocupada por um SQL Server instalado na máquina.
MSSQL_PORT=14333

# Segundos que o emulador espera o SQL Server antes de iniciar (padrão 15).
SQL_WAIT_INTERVAL=20
